---
layout: base.njk
title: "All of the bastardised Food!"
permalink: "/food/"
---

{# {% include "hero.njk" %} #}

<section class="latest">
    <h2>All of the Bastardisations</h2>
    <div class="post-grid">
        {% for post in collections.food %}
            <article class="post-card">
                <a href="{{ post.url }}">
                    <picture>
                        <source srcset="{{ post.data.card_image | replace('.jpg', '.avif') }}" type="image/avif">
                        <source srcset="{{ post.data.card_image | replace('.jpg', '.webp') }}" type="image/webp">
                        <img src="{{ post.data.card_image or 'https://picsum.photos/id/63/400' }}" alt="{{ post.data.title }}">
                    </picture>
                </a>
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <p class="excerpt">{{ post.data.excerpt or '' }}</p>
                <span class="meta">Posted: {{ post.date | date('yyyy-MM-dd') }}</span>
            </article>
        {% endfor %}
    </div>
</section>