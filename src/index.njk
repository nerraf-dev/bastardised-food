---
layout: base.njk
title: "Bastardised Food!"
---

{% set heroTitle = "Welcome to Bastardised Food" %}
{% set heroSubtitle = "Bollocks to conventions!" %}
{% include "hero.njk" %}

<section class="latest">
    <h2>Latest Bastardisations</h2>
    <div class="post-grid">
        {% for post in collections.food %}
            <article class="post-card">
                <img src="{{ post.data.cover_image or 'https://picsum.photos/id/63/400' }}" alt="{{ post.data.title }}">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <p class="excerpt">{{ post.data.excerpt or '' }}</p>
                <span class="meta">Posted: {{ post.date | date('yyyy-MM-dd') }}</span>
            </article>
        {% endfor %}
    </div>
</section>